{
  "info": {
    "_postman_id": "39561be8-2bf2-4c54-8805-06cfdca6a2f9",
    "name": "MediSlot API",
    "description": "Postman Collection v2.1 for the MediSlot API. Set the collection variables for your test account. Login stores accessToken and refreshToken automatically. Use test accounts and non-production data for write or delete requests.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{accessToken}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    { "key": "baseUrl", "value": "https://uoflt5e3zj.execute-api.us-east-1.amazonaws.com/dev", "type": "string" },
    { "key": "accessToken", "value": "", "type": "string" },
    { "key": "refreshToken", "value": "", "type": "string" },
    { "key": "email", "value": "", "type": "string" },
    { "key": "password", "value": "", "type": "string" },
    { "key": "role", "value": "PATIENT", "type": "string" },
    { "key": "firstName", "value": "Test", "type": "string" },
    { "key": "lastName", "value": "User", "type": "string" },
    { "key": "doctorId", "value": "1", "type": "string" },
    { "key": "consultationTypeId", "value": "1", "type": "string" },
    { "key": "availabilityPatternId", "value": "1", "type": "string" },
    { "key": "blackoutId", "value": "1", "type": "string" },
    { "key": "startDate", "value": "2026-12-01", "type": "string" },
    { "key": "endDate", "value": "2026-12-07", "type": "string" },
    { "key": "scheduleDate", "value": "2026-12-01", "type": "string" },
    { "key": "consultationType", "value": "", "type": "string" },
    { "key": "photoContentType", "value": "image/jpeg", "type": "string" },
    { "key": "photoKey", "value": "", "type": "string" }
  ],
  "item": [
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "auth": { "type": "noauth" },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\",\n  \"role\": \"{{role}}\",\n  \"first_name\": \"{{firstName}}\",\n  \"last_name\": \"{{lastName}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/auth/register",
            "description": "Creates a DOCTOR or PATIENT account. Password must be at least 10 characters and contain a letter and a number."
          }
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "auth": { "type": "noauth" },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/auth/login",
            "description": "Logs in and saves accessToken and refreshToken from a successful response.",
            "event": [
              {
                "listen": "test",
                "script": {
                  "type": "text/javascript",
                  "exec": [
                    "if (pm.response.code === 200) {",
                    "  const tokens = pm.response.json();",
                    "  if (tokens.access_token) pm.collectionVariables.set('accessToken', tokens.access_token);",
                    "  if (tokens.refresh_token) pm.collectionVariables.set('refreshToken', tokens.refresh_token);",
                    "}"
                  ]
                }
              }
            ]
          }
        },
        {
          "name": "Refresh access token",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "auth": { "type": "noauth" },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refresh_token\": \"{{refreshToken}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/auth/refresh",
            "description": "Uses the saved refresh token and updates accessToken after a successful refresh.",
            "event": [
              {
                "listen": "test",
                "script": {
                  "type": "text/javascript",
                  "exec": [
                    "if (pm.response.code === 200) {",
                    "  const tokens = pm.response.json();",
                    "  if (tokens.access_token) pm.collectionVariables.set('accessToken', tokens.access_token);",
                    "}"
                  ]
                }
              }
            ]
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "auth": { "type": "noauth" },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refresh_token\": \"{{refreshToken}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/auth/logout",
            "description": "Revokes the session associated with the refresh token. Clears the saved tokens on success.",
            "event": [
              {
                "listen": "test",
                "script": {
                  "type": "text/javascript",
                  "exec": [
                    "if (pm.response.code === 200) {",
                    "  pm.collectionVariables.set('accessToken', '');",
                    "  pm.collectionVariables.set('refreshToken', '');",
                    "}"
                  ]
                }
              }
            ]
          }
        }
      ]
    },
    {
      "name": "Doctor API",
      "item": [
        {
          "name": "Get my profile",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/doctors/me",
            "description": "Requires a DOCTOR access token."
          }
        },
        {
          "name": "Update my profile",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"first_name\": \"{{firstName}}\",\n  \"last_name\": \"{{lastName}}\",\n  \"phone_number\": \"9876543210\",\n  \"license_number\": \"TSMC123456\",\n  \"experience_years\": 5,\n  \"qualification\": \"MBBS\",\n  \"languages\": \"English, Hindi\",\n  \"hospital_name\": \"Example Hospital\",\n  \"city\": \"Chennai\",\n  \"address\": \"Example Road\",\n  \"hospital_phone\": \"9876543211\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/doctors/me",
            "description": "Requires a DOCTOR token. Replace sample profile values with values appropriate for a test doctor. License numbers must be 2-5 uppercase letters followed by 4-10 digits."
          }
        },
        {
          "name": "Create profile photo upload URL",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"content_type\": \"{{photoContentType}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/doctors/me/photo",
            "description": "Returns a short-lived S3 upload URL. Upload the image to that URL with PUT, then call Confirm profile photo using the returned key."
          }
        },
        {
          "name": "Confirm profile photo",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"key\": \"{{photoKey}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/doctors/me/photo/confirm",
            "description": "Confirms an image already uploaded to S3 using the key returned by Create profile photo upload URL."
          }
        },
        {
          "name": "List my consultation types",
          "request": { "method": "GET", "url": "{{baseUrl}}/doctors/me/consultation-types" }
        },
        {
          "name": "Add consultation type",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"consultation_name\": \"Quick Consult\",\n  \"duration_minutes\": 15,\n  \"capacity\": 1,\n  \"fee\": 500\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/doctors/me/consultation-types",
            "description": "Requires a verified DOCTOR. Valid names: Quick Consult (15 minutes, capacity 1), Standard Consult (30, capacity 1), Detailed Consult (60, capacity 1), Health Camp Session (60, capacity 2-10)."
          }
        },
        {
          "name": "Update consultation type",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"consultation_name\": \"Quick Consult\",\n  \"duration_minutes\": 15,\n  \"capacity\": 1,\n  \"fee\": 600\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/doctors/me/consultation-types/{{consultationTypeId}}"
          }
        },
        {
          "name": "Delete consultation type",
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/doctors/me/consultation-types/{{consultationTypeId}}",
            "description": "Requires a verified DOCTOR. The type cannot be deleted while it has availability patterns or generated slots."
          }
        },
        {
          "name": "List my availability patterns",
          "request": { "method": "GET", "url": "{{baseUrl}}/doctors/me/availability" }
        },
        {
          "name": "Create availability pattern",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"consultation_type_id\": {{consultationTypeId}},\n  \"repeat_days\": [\"MONDAY\", \"WEDNESDAY\"],\n  \"start_time\": \"09:00\",\n  \"end_time\": \"12:00\",\n  \"start_date\": null,\n  \"end_date\": null,\n  \"is_active\": true\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/doctors/me/availability",
            "description": "Requires a verified DOCTOR and an active consultation type belonging to that doctor. Leave both dates null for a repeating pattern without date bounds."
          }
        },
        {
          "name": "Replace availability patterns",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"patterns\": [\n    {\n      \"consultation_type_id\": {{consultationTypeId}},\n      \"day_of_week\": \"MONDAY\",\n      \"start_time\": \"09:00\",\n      \"end_time\": \"12:00\"\n    }\n  ]\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/doctors/me/availability",
            "description": "Bulk replace availability patterns. This may remove existing patterns and generated slots; use a test account."
          }
        },
        {
          "name": "Update availability pattern",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"consultation_type_id\": {{consultationTypeId}},\n  \"repeat_days\": [\"MONDAY\", \"WEDNESDAY\"],\n  \"start_time\": \"10:00\",\n  \"end_time\": \"13:00\",\n  \"start_date\": null,\n  \"end_date\": null,\n  \"is_active\": true\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/doctors/me/availability/{{availabilityPatternId}}"
          }
        },
        {
          "name": "Delete availability pattern",
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/doctors/me/availability/{{availabilityPatternId}}",
            "description": "Deletes the selected availability pattern. Existing booked slots cannot be removed."
          }
        },
        {
          "name": "List my blackouts",
          "request": { "method": "GET", "url": "{{baseUrl}}/doctors/me/blackouts" }
        },
        {
          "name": "Create blackout",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"start_datetime\": \"2026-12-02T09:00:00Z\",\n  \"end_datetime\": \"2026-12-02T12:00:00Z\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/doctors/me/blackouts",
            "description": "Adds a blackout window and removes matching generated slots. Use UTC timestamps; alternatively send start_date and end_date."
          }
        },
        {
          "name": "Delete blackout",
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/doctors/me/blackouts/{{blackoutId}}",
            "description": "Deletes the selected blackout and queues slot regeneration."
          }
        },
        {
          "name": "Get my schedule for a day",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/doctors/me/schedule?date={{scheduleDate}}",
            "description": "Returns the doctor's slot and appointment details for the requested UTC date."
          }
        }
      ]
    },
    {
      "name": "Patient API",
      "item": [
        {
          "name": "Get my profile",
          "request": { "method": "GET", "url": "{{baseUrl}}/patients/me" },
          "description": "Requires a PATIENT access token."
        },
        {
          "name": "Update my profile",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"first_name\": \"{{firstName}}\",\n  \"last_name\": \"{{lastName}}\",\n  \"phone_number\": \"9876543210\",\n  \"date_of_birth\": \"1990-01-15\",\n  \"gender\": \"Prefer not to say\",\n  \"emergency_contact\": \"9876543211\",\n  \"emergency_contact_name\": \"Emergency Contact\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/patients/me",
            "description": "Requires a PATIENT token. Send only fields you want to update."
          }
        },
        {
          "name": "Search doctors",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/doctors/search?name=&hospital=&specialization=&city=&page=1&limit=10",
            "description": "Requires a PATIENT token. Optional filters: name, hospital, specialization, city. Pagination limit is 1-100."
          }
        },
        {
          "name": "Get public doctor profile",
          "request": {
            "method": "GET",
            "auth": { "type": "noauth" },
            "url": "{{baseUrl}}/doctors/{{doctorId}}/profile",
            "description": "Public endpoint; no access token is required."
          }
        },
        {
          "name": "List consultation types",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/doctors/availability/types",
            "description": "Requires a PATIENT access token."
          }
        },
        {
          "name": "Search availability across verified doctors",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/doctors/availability/search?start_date={{startDate}}&end_date={{endDate}}&consultation_type={{consultationType}}",
            "description": "Requires a PATIENT token. Add an optional consultation_type query parameter to filter results."
          }
        },
        {
          "name": "Get availability for one doctor",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/doctors/{{doctorId}}/availability?start_date={{startDate}}&end_date={{endDate}}&consultation_type={{consultationType}}",
            "description": "Requires a PATIENT token. Add an optional consultation_type query parameter to filter results."
          }
        }
      ]
    }
  ]
}
